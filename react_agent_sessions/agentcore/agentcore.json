{
  "name": "ReactAgentSessions",
  "version": 2,
  "managedBy": "CDK",
  "tags": {
    "agentcore:project-name": "ReactAgentSessions"
  },
  "runtimes": [
    {
      "name": "temporal_worker",
      "description": "Harness ReAct agent (OpenAI Agents SDK) on a scale-to-zero Temporal worker with activity sessions",
      "build": "CodeZip",
      "entrypoint": "agentcore_worker.py",
      "codeLocation": ".",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM",
      "envVars": [
        {
          "name": "TEMPORAL_ADDRESS",
          "value": "us-west-2.aws.api.temporal.io:7233"
        },
        {
          "name": "TEMPORAL_NAMESPACE",
          "value": "test-nikk.a2dd6"
        },
        {
          "name": "REACT_AGENT_SECRET_ID",
          "value": "react-agent-sessions/keys"
        },
        {
          "name": "REACT_AGENT_TASK_QUEUE",
          "value": "react-agent-sessions"
        },
        {
          "name": "TEMPORAL_DEPLOYMENT_NAME",
          "value": "react-agent-sessions-python"
        },
        {
          "name": "TEMPORAL_BUILD_ID",
          "value": "1.0.0"
        },
        {
          "name": "AWS_REGION",
          "value": "us-west-2"
        },
        {
          "name": "AGENTCORE_DEBOUNCE_SECONDS",
          "value": "60"
        },
        {
          "name": "SESSION_HEARTBEAT_TABLE",
          "value": "agent-session-heartbeats"
        },
        {
          "name": "USE_ACTIVITY_SESSIONS",
          "value": "0"
        },
        {
          "name": "MODEL_PROVIDER",
          "value": "bedrock"
        },
        {
          "name": "BEDROCK_MODEL",
          "value": "us.openai.gpt-5.6-terra"
        }
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 60,
        "maxLifetime": 28800
      },
      "endpoints": {
        "temporal": {
          "version": 1,
          "description": "Invoked by Temporal Cloud Serverless Workers"
        }
      },
      "additionalPolicies": [
        "secrets-policy.json",
        "session-heartbeat-policy.json",
        "bedrock-policy.json"
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": [],
  "payments": []
}
